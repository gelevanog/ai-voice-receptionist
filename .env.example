# Copy to .env and adjust. Every variable is optional; defaults are shown. Keys stay out of the repository.

# ---------------------------------------------------------------------------------------------------------
# LLM (the receptionist's brain)
# ---------------------------------------------------------------------------------------------------------
# fake (rule-based, offline, deterministic; default) | openrouter | openai | anthropic
CALLIE_LLM_PROVIDER=fake
# Empty = provider default (openrouter: google/gemma-4-31b-it:free, openai: gpt-5-mini, anthropic: claude-sonnet-5).
# The evaluation used inclusionai/ling-3.0-flash-sante:free.
CALLIE_LLM_MODEL=
# Fallback models tried in order when the first one fails or is rate limited (JSON list).
CALLIE_LLM_FALLBACK_MODELS=[]
# Refuse any OpenRouter model id that does not end in ":free", and any answer served by a non-free model.
CALLIE_REQUIRE_FREE_MODELS=true
CALLIE_LLM_TEMPERATURE=0.3
CALLIE_LLM_MAX_TOKENS=400
CALLIE_LLM_TIMEOUT_SECONDS=60
# OPENROUTER_API_KEY=sk-or-...
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1   (any OpenAI-compatible server, e.g. http://localhost:11434/v1 for Ollama)
# ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------------------------------------
# Speech (local, CPU)
# ---------------------------------------------------------------------------------------------------------
# fake (scripted lines, no download) | whisper (faster-whisper)
CALLIE_STT_PROVIDER=fake
# tiny.en | base.en | small.en | ... (base.en: best latency/accuracy trade-off measured on this project's CPU)
CALLIE_STT_MODEL=base.en
CALLIE_STT_THREADS=4
# fake (tones) | kokoro (Kokoro-82M, agent voice) | piper
CALLIE_TTS_PROVIDER=fake
# Kokoro voice id (af_heart, af_bella, am_michael, bf_emma, ...)
CALLIE_TTS_VOICE=af_heart
CALLIE_TTS_SPEED=1.05
CALLIE_TTS_THREADS=4
# energy (deterministic, no download) | silero (Silero VAD, ONNX)
CALLIE_VAD_PROVIDER=energy
# Where `callie download-models` puts Silero VAD, Kokoro and the Piper caller voice.
# CALLIE_MODELS_DIR=~/.cache/callie/models

# ---------------------------------------------------------------------------------------------------------
# Turn-taking
# ---------------------------------------------------------------------------------------------------------
CALLIE_VAD_THRESHOLD=0.5
# Silence that ends the caller's turn. Shorter answers faster but cuts off callers who pause mid-sentence.
CALLIE_ENDPOINT_SILENCE_MS=550
CALLIE_MIN_SPEECH_MS=120
# Caller speech while Callie talks: pause after this much speech, interrupt for good after HARD_INTERRUPT_MS,
# or resume when the words were only a backchannel ("mm-hmm").
CALLIE_BARGE_IN_MIN_SPEECH_MS=250
CALLIE_HARD_INTERRUPT_MS=1200
CALLIE_SILENCE_PROMPT_SECONDS=9
# Say "One moment." if the model has not produced a word after this long (0 = never).
CALLIE_FILLER_AFTER_MS=1800
# A plain "yes" to a read-back executes the confirmed action without another model call.
CALLIE_FAST_CONFIRM=true

# ---------------------------------------------------------------------------------------------------------
# Business and storage
# ---------------------------------------------------------------------------------------------------------
# Your own clinic YAML (hours, services, resources) and knowledge base; default: the fictional Brightside Dental.
# CALLIE_CLINIC_FILE=configs/my-clinic.yaml
CALLIE_DATABASE_URL=sqlite:///data/callie.db
# CALLIE_DATABASE_URL=postgresql+psycopg://user:pass@db:5432/callie   (needs a Postgres driver installed)
CALLIE_RECORDINGS_DIR=data/recordings
CALLIE_RESULTS_DIR=results
# Freeze the clinic clock (local ISO time), e.g. for demos and the evaluation. Empty = real time.
CALLIE_NOW=
# Fill an empty database with fictional appointments for the next three weeks.
CALLIE_SEED_DEMO_DATA=true

# ---------------------------------------------------------------------------------------------------------
# Telephony and integrations
# ---------------------------------------------------------------------------------------------------------
# Public HTTPS URL of this server (e.g. an ngrok tunnel); used in the TwiML <Stream url> and signature checks.
CALLIE_PUBLIC_BASE_URL=
CALLIE_TWILIO_ACCOUNT_SID=
CALLIE_TWILIO_AUTH_TOKEN=
# Your Twilio number, used as the sender of confirmation texts.
CALLIE_TWILIO_FROM_NUMBER=
CALLIE_TWILIO_VALIDATE_SIGNATURE=true
# Where transfers to a human go (<Dial>).
CALLIE_TRANSFER_NUMBER=+15555550100
# Optional Google Calendar mirror: busy times block slots; Callie's bookings appear as events.
CALLIE_GOOGLE_CALENDAR_ID=
CALLIE_GOOGLE_ACCESS_TOKEN=

# ---------------------------------------------------------------------------------------------------------
# Budget for real LLM calls (retries, cache, ledger)
# ---------------------------------------------------------------------------------------------------------
CALLIE_LLM_CACHE_DIR=.cache/llm
CALLIE_LLM_LEDGER=results/calls.jsonl
CALLIE_LLM_MAX_CALLS=420
CALLIE_LLM_MIN_SECONDS_BETWEEN_REQUESTS=1.0
CALLIE_LLM_MAX_RETRIES=3

CALLIE_LOG_LEVEL=INFO
# console (human-readable) or json
CALLIE_LOG_FORMAT=console
